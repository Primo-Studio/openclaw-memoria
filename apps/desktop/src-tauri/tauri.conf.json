{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memoria",
  "version": "0.1.0",
  "identifier": "fr.primo-studio.memoria",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Memoria",
        "width": 1080,
        "height": 740,
        "minWidth": 640,
        "minHeight": 480,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "Developer ID Application: Primo Studio (4QB44XVHNL)"
    }
  }
}