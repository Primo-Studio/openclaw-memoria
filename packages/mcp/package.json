    "memoria-mcp": "./dist/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@memoria/core": "*",
    "@memoria/daemon": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
