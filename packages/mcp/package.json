{
  "name": "@memoria/mcp",
  "version": "0.1.0",
  "description": "Serveur MCP Memoria — un par agent, relaie vers le daemon local. Ne touche jamais les fichiers SQLite en direct.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
