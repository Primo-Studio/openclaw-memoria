{
  "name": "memoria",
  "private": true,
  "version": "0.1.0",
  "description": "Memoria — mémoire locale multi-agent : core découplé + daemon local + MCP. Locale, à nous, et qui ne recommence jamais à zéro.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build:vite --workspace @memoria/web",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
