<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>fr.primo-studio.memoria.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/primostudio/openclaw-memoria/scripts/watchdog.sh</string>
  </array>
  <!-- Un contrôle par minute : 3 ratés de suite = alerte au bout de 3 minutes. -->
  <key>StartInterval</key>
  <integer>60</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/primostudio/.memoria/watchdog.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/primostudio/.memoria/watchdog.err.log</string>
</dict>
</plist>
